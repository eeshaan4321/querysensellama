# Set to "true" (or "1") to run entirely on src/mock fixtures with no backend.
# Mock mode is opt-in: any other value, including unset or misspelled, calls
# the real backend. A typo here costs you the backend, never the truth.
VITE_USE_MOCK=false

# QuerySense backend (CAPSTONE CODE) — Spring Boot on server.port=8080.
# AppConfig's CORS mapping allows all origins, so the dev server can call
# this cross-origin directly; no Vite proxy is needed.
VITE_API_BASE_URL=http://localhost:8080

# Axios request timeout in ms. Must stay above the backend's own
# http.client.read-timeout-ms (60000), which is how long it waits on the
# Ollama LLM fallback before giving up.
VITE_API_TIMEOUT=65000
